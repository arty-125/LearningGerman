          "id": "b1-grammar-infinitive-constructions",
          "categoryId": "b1-grammar",
          "levelId": "b1",
          "title": "Infinitive Constructions",
          "description": "zu + Infinitiv, um...zu, ohne...zu, anstatt...zu",
          "difficulty": 4,
